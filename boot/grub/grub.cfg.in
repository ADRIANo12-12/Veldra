### /boot/grub/grub.cfg.in — GRUB configuration for Veldra live media.
#
# Veldra
# Copyright (c) 2026 Adrian Sikora
# All rights reserved.
# Proprietary and confidential.
#
# This config is placed at /boot/grub/grub.cfg on the live ISO by the build
# (grub-mkrescue uses it verbatim). The first entry is the default and
# boots Veldra with a short 2-second timeout so the system starts by itself
# and never strands the user on the GRUB menu.
#
# @VERSION@ is substituted from config/veldra.conf at build time.

set default=0
set timeout=2
set gfxpayload=text

terminal_output console
terminal_input console

menuentry "Veldra @VERSION@ (automatic)" {
    linux /boot/vmlinuz-linux quiet loglevel=3 console=ttyS0,115200
    initrd /boot/initramfs-linux-veldra.img
}

menuentry "Veldra @VERSION@ (verbose)" {
    linux /boot/vmlinuz-linux console=ttyS0,115200
    initrd /boot/initramfs-linux-veldra.img
}

menuentry "Veldra rescue shell" {
    linux /boot/vmlinuz-linux single console=ttyS0,115200
    initrd /boot/initramfs-linux-veldra.img
}

if [ "$grub_platform" = "efi" ]; then
    menuentry "UEFI Firmware Settings" {
        fwsetup
    }
fi