# system/os-release.in — Veldra identity, written to /etc/os-release.
#
# Veldra
# Copyright (c) 2026 Adrian Sikora
# All rights reserved.
# Proprietary and confidential.
#
# Template: version tags (e.g. @VERSION@, @CODENAME@) are substituted by
# scripts/version.sh (inject) at build/install time so the version stays
# centralized in config/veldra.conf. Never hardcode a version here.
#
# Kept format-compatible with the Arch Linux os-release(5) layout so
# tools that read /etc/os-release keep working, while honestly reporting
# that Veldra is Arch-based.

NAME="Veldra"
ID=veldra
ID_LIKE="arch"
VARIANT="TUI Edition"
VARIANT_ID=tui

VERSION="@VERSION@"
VERSION_ID="@VERSION@"
VERSION_CODENAME="@CODENAME@"
PRETTY_NAME="Veldra @VERSION@ «@CODENAME@»"
BUILD_ID=rolling

# Cyan/turquoise accent foreground.
ANSI_COLOR="38;2;0;212;255"
LOGO=veldra

HOME_URL="@HOME@"
SUPPORT_URL="@HOME@"
BUG_REPORT_URL="@ISSUES@"
