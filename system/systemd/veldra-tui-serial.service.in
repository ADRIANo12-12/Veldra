[Unit]
Description=Veldra Terminal Shell on serial console
After=systemd-user-sessions.service local-fs.target
Conflicts=serial-getty@ttyS0.service
Before=serial-getty@ttyS0.service

[Service]
Type=simple
User=@USER@
Group=tty
WorkingDirectory=/home/@USER@
Environment=TERM=xterm-256color
ConditionPathExists=/dev/ttyS0
TTYPath=/dev/ttyS0
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/local/bin/veldra-tui
Restart=on-failure
RestartSec=0.5

[Install]
WantedBy=multi-user.target
